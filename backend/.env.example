# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string. Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garighor?schema=public"

# Long random string used to sign login sessions. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# --- AI chat assistant ---
# "gemini"    — Google's free-forever tier. No credit card, doesn't expire.
#               Get a key at https://aistudio.google.com/apikey (any Google account).
# "anthropic" — Claude. Requires API credit on your Anthropic Console account.
AI_PROVIDER="gemini"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Only used if AI_PROVIDER=anthropic. Server-side only — never put this in
# frontend code.
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
ANTHROPIC_MODEL="claude-sonnet-5"

# Port the API server listens on.
PORT=4000

# The URL of your frontend, so the browser is allowed to call this API.
# Vite's default local dev URL is shown below — update for production.
CORS_ORIGIN="http://localhost:5173"

# --- Photo storage ---
# "local"      — files saved to disk on this server. Fine for your own PC.
#                Do NOT use this on Render's free tier — its free web
#                services have no persistent disk, so photos would vanish
#                on every redeploy or restart.
# "cloudinary" — files stored on Cloudinary's free tier (persists forever,
#                no credit card required). Use this for any free hosting.
STORAGE_DRIVER="local"

# The public URL of THIS backend server, used to build full image URLs when
# STORAGE_DRIVER=local (e.g. http://localhost:4000/uploads/abc123.jpg).
# Not used when STORAGE_DRIVER=cloudinary.
PUBLIC_BASE_URL="http://localhost:4000"

# Only needed when STORAGE_DRIVER=cloudinary. Free account at cloudinary.com
# — these three values are on your Cloudinary dashboard after signup.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Credentials for the one admin (dealer) account the seed script creates.
ADMIN_NAME="Showroom Owner"
ADMIN_EMAIL="owner@garighormotors.example"
ADMIN_PASSWORD="change-this-password"

# Where `npm run backup` writes database + photo backups. Point this at an
# external drive or a cloud-synced folder (OneDrive/Google Drive/Dropbox
# desktop folder) — not just another folder on this same disk — so a backup
# still exists if this machine's drive fails. Example for an external drive
# on Windows: BACKUP_DIR="D:/GariGhorBackups". On Linux/macOS a synced
# folder like BACKUP_DIR="/home/you/Dropbox/garighor-backups" works well.
BACKUP_DIR="./backups"

# How many most-recent backups to keep — older ones are deleted automatically
# each time a new backup completes.
BACKUP_KEEP=14
